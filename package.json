{
  "name": "dreamwalker",
  "version": "0.1.0",
  "description": "A personal agent on Pi Durable, built for Netlify Server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dreamwalker": "node --no-warnings --env-file-if-exists=.env src/main.ts",
    "dev": "EXPERIMENTAL_NETLIFY_SERVER=true netlify dev",
    "check": "tsc && pnpm lint && pnpm test",
    "lint": "oxlint --deny-warnings src test netlify",
    "test": "node --no-warnings --test test/*.test.ts"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@netlify/database": "2.0.1",
    "@netlify/server": "0.1.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@netlify/database-dev": "1.0.1",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "dreamwalker": "src/main.ts"
  }
}
